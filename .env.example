# Supabase Configuration (Required for Database, Auth & Storage)
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (Required for AI Leaf Diagnosis, Audio & Agri-Buddy Chatbot)
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key

# Optional / External Integrations
# AGMARKNET API Key for Real-Time Mandi Prices
VITE_AGMARKNET_API_KEY=your-agmarknet-key

# Resend Email API Key for OTP & Notifications
VITE_RESEND_API_KEY=your-resend-api-key

# MiniMoth WhatsApp & SMS OTP Service
VITE_MINIMOTH_API_KEY=your-minimoth-api-key

